{
  "name": "oa-switcher",
  "version": "0.1.2",
  "type": "module",
  "description": "OA 多账号一键切换的浏览器扩展 · Chrome MV3",
  "license": "MIT",
  "author": "oa-switcher contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leavendger/oa-switcher.git"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "dev": "node scripts/build-watch.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint src tests",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "check:manifest": "node scripts/check-manifest.mjs",
    "package": "node scripts/package.mjs",
    "check:package": "node scripts/check-package.mjs",
    "key:generate": "node scripts/make-key.mjs",
    "icons": "node scripts/make-icons.mjs",
    "serve:fixture": "node scripts/serve-fixture.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
